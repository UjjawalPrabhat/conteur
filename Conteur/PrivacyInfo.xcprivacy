<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!-- Nothing is collected. The transcript, the scores and the history stay in the app's
	     own container; there is no network code in the binary at all. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<!-- No required-reason APIs are called. Recording cleanup enumerates and deletes inside
	     the app's own Documents directory without reading file attributes. -->
	<key>NSPrivacyAccessedAPITypes</key>
	<array/>
</dict>
</plist>
